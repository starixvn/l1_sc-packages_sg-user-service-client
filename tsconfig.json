{
    "compilerOptions": {
      "target": "ES2020",           // Use an appropriate target for the features you need
      "module": "CommonJS",         // This is important since your game client is CommonJS
      "declaration": true,          // Generates .d.ts files for type definitions
      "outDir": "dist",             // Output directory for compiled code
      "strict": true,               // Enable strict type checking
      "esModuleInterop": true,      // Allows importing CommonJS modules in an ES6 style
      "emitDecoratorMetadata": true, // Only if you are using decorators
      "experimentalDecorators": true, // Only if using decorators
      "sourceMap": false,  // Disable source maps globally
    },
    "include": ["src/**/*"],        // Include your source files
    "exclude": ["node_modules", "dist"]
  }
  