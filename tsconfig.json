{
    "compilerOptions": {
        "target": "ESNext", // Targets the latest ECMAScript version
        "module": "ESNext", // Generates ESNext modules
        "moduleResolution": "Node", // Resolves modules similar to Node.js
        "esModuleInterop": true, // Enables compatibility with CommonJS modules
        "forceConsistentCasingInFileNames": true, // Enforces consistent casing in file names
        "strict": true, // Enables strict type checking options
        "skipLibCheck": true, // Skips type checking of declaration files
        "outDir": "./dist", // Specifies the output directory for compiled files
        "rootDir": "./src", // Specifies the root directory of input files
        "declaration": true, // Generates corresponding '.d.ts' files
        "sourceMap": true // Generates source map files for debugging
    },
    "include": ["src"], // Specifies the files to include in the compilation
    "exclude": ["node_modules"] // Excludes the node_modules directory
}
