{
    "name": "@sg/sg-user-service-client",
    "version": "1.8.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "repository": "https://git3.nexdev.net/sc-packages/sc-user-service-client.git",
    "author": {
        "email": "pentagon@luminetsoft.com",
        "name": "pentagon"
    },
    "license": "MIT",
    "scripts": {
        "reg": "npm set registry http://npm.lumigame.com",
        "build": "tsc",
        "verpatch": "npm version patch",
        "verminor": "npm version minor",
        "betaver": "npm version prerelease --preid beta",
        "pub": "tsc && npm publish --registry http://npm.lumigame.com",
        "pubbeta": "tsc && npm publish --registry http://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release"
    },
    "devDependencies": {
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@semantic-release/changelog": "^5.0.1",
        "@semantic-release/commit-analyzer": "^8.0.1",
        "@semantic-release/git": "^9.0.0",
        "@semantic-release/gitlab": "^6.0.4",
        "@semantic-release/npm": "^7.0.5",
        "@semantic-release/release-notes-generator": "^9.0.1",
        "husky": "^4.2.5",
        "sc-semantic-release": "^1.2.0",
        "semantic-release": "^17.2.1",
        "typescript": "^4.2.3"
    },
    "dependencies": {
        "axios": "^1.7.4"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "release": {
        "extends": [
            "sc-semantic-release"
        ]
    }
}
